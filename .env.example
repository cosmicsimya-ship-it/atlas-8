# ATLAS v7 — Environment Configuration
# Copy this file to .env:  cp .env.example .env
# Then add your OpenAI API key below.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001

# Frontend (Vite) — optional; defaults to http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# Telegram bot (optional — run: node server/telegram.js)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLE_POLLING=true
BACKEND_URL=http://localhost:3001
