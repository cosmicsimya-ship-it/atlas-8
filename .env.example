# ATLAS v7 — Environment Configuration
# Copy this file to .env:  cp .env.example .env
# Then add your OpenAI API key below.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001

# Frontend (Vite) — optional; defaults to http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# Telegram bot (optional — run: node server/telegram.js)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLE_POLLING=true
# Optional: only answer group messages that mention Atlas / @bot / reply to bot
# TELEGRAM_GROUP_REQUIRE_MENTION=true
BACKEND_URL=http://localhost:3001

# Symbolic Analysis Faz 1–2 metadata / disclosure (optional).
# When true/1: atlas-letter-number-v2 labels + additive assessment/snapshots.
# Calculation totals are unchanged either way.
# ATLAS_SYMBOLIC_METADATA_V2=true

# Symbolic Analysis Faz 3 classical Ebced (optional; default OFF).
# ATLAS_CLASSICAL_ABJAD_V1=true|shadow — enables classical runner / shadow compare.
# When on, Latin motif remains the user-facing primary; classical shadow is additive metadata.
# ATLAS_CLASSICAL_ABJAD_SHADOW=true — force shadow compare when V1 is on (default when V1=on).
# ATLAS_CLASSICAL_ABJAD_V1=false

# Founder identity linking (optional — maps user IDs to founder-primary)
# Telegram: numeric from.id only (comma-separated for multiple)
# ATLAS_FOUNDER_TELEGRAM_IDS=123456789
# Web: localStorage key atlas_web_session_id (web: prefix optional)
# ATLAS_FOUNDER_WEB_USER_IDS=1730123456789-abc123xyz
# Combined full userIds (optional alternative)
# ATLAS_FOUNDER_USER_IDS=telegram:123456789,web:1730123456789-abc123xyz
