# ATLAS — Environment Configuration
# Copy this file to .env:  cp .env.example .env
# Then add your OpenAI API key below.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional multimodal models
# OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
PORT=3001

# Frontend (Vite) — optional.
# Leave unset in local `npm run dev` so the SPA calls same-origin `/api/*` via the Vite proxy.
# Set explicitly for production builds or when the UI is not served by Vite.
# VITE_BACKEND_URL=http://localhost:3001
# Incomplete chat capability chips ("Konuşurken açılan yollar") — default OFF.
# VITE_CAPABILITY_DISCOVERY=true

# CORS / CSRF allowed browser origins (comma-separated). Exact https?/host[:port] only.
# Defaults: localhost Vite ports (non-production) + https://cosmicsimya.com (+ www).
# In NODE_ENV=production only https origins are accepted (localhost defaults dropped).
# ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cosmicsimya.com,https://www.cosmicsimya.com
# FRONTEND_ORIGIN=http://localhost:5173

# Session cookies
# NODE_ENV=production
# ATLAS_SECURE_COOKIES=true
# ATLAS_SESSION_TTL_MS=604800000

# Telegram bot (optional — run: node server/telegram.js)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLE_POLLING=true
# Optional: only answer group messages that mention Atlas / @bot / reply to bot
# TELEGRAM_GROUP_REQUIRE_MENTION=true
# TELEGRAM_MAX_IMAGE_BYTES=10485760
# Polling resilience after PC sleep/wake
# TELEGRAM_POLL_STALE_MS=120000
# TELEGRAM_POLL_WATCHDOG_MS=30000
# OPENAI_TIMEOUT_MS=120000
BACKEND_URL=http://localhost:3001

# Required for Telegram → backend hop (min 16 chars). Generate a strong random secret.
ATLAS_INTERNAL_BOT_SECRET=

# Symbolic Analysis Faz 1–2 metadata / disclosure (optional).
# When true/1: atlas-letter-number-v2 labels + additive assessment/snapshots.
# Calculation totals are unchanged either way.
# ATLAS_SYMBOLIC_METADATA_V2=true

# Symbolic Analysis Faz 3 classical Ebced (optional; default OFF).
# ATLAS_CLASSICAL_ABJAD_V1=true|shadow — enables classical runner / shadow compare.
# When on, Latin motif remains the user-facing primary; classical shadow is additive metadata.
# ATLAS_CLASSICAL_ABJAD_SHADOW=true — force shadow compare when V1 is on (default when V1=on).
# ATLAS_CLASSICAL_ABJAD_V1=false

# Domain Core FAZ 2 scaffolding (optional; default OFF — chat path unchanged).
# ATLAS_DOMAIN_CORE=true — reserved for future chat consumption of adapters.
# ATLAS_DOMAIN_CORE_DUAL_RUN=true — enable adapter dual-run validation helpers.

# ── Quran verse lookup (fail-closed master switch; default OFF) ──
# Verse text (Arabic + attributed Turkish meal) is only ever shown from a
# verified live source; the LLM never invents verse text. Until this is set
# to exactly "true", the trusted verse store is never constructed and every
# valid surah/ayah query answers with a "kaynaktan doğrulayamadım" refusal —
# see server/quran-verse-lookup/store/index.js#createVerseStore.
# Two-provider fallback chain (either one's outage alone never disables the
# feature): Al Quran Cloud (Diyanet-sourced Turkish meal) first, then
# Açık Kur'an API. Both are queried with a short per-request timeout so a
# hung provider yields to the next one.
# QURAN_VERSE_TEXT_ENABLED=true
# QURAN_VERSE_ALQURAN_CLOUD_BASE_URL=https://api.alquran.cloud
# QURAN_VERSE_API_BASE_URL=https://api.acikkuran.com
# QURAN_VERSE_STORE=off   # set to "off" to force fail-closed even when enabled above

# ── Audio Studio (capability flags; processing OFF by default) ──
# ATLAS_AUDIO_UPLOAD_ENABLED=true
# ATLAS_AUDIO_ANALYSIS_ENABLED=true
# ATLAS_AUDIO_PROCESSING_ENABLED=false
# ATLAS_AUDIO_TRANSCRIPTION_ENABLED=true
# ATLAS_AUDIO_STEM_SEPARATION_ENABLED=false
# ATLAS_AUDIO_TUNING_ENABLED=false
# ATLAS_AUDIO_MIXING_ENABLED=false
# ATLAS_AUDIO_MASTERING_ENABLED=false
# ATLAS_AUDIO_GENERATION_ENABLED=false
# ATLAS_AUDIO_EXTERNAL_UPLOAD_ENABLED=false
# ATLAS_AUDIO_MAX_BYTES=52428800
# ATLAS_AUDIO_MAX_DURATION_SEC=1800
# ATLAS_AUDIO_RETENTION_DAYS=14
# ATLAS_FFMPEG_PATH=ffmpeg
# ATLAS_FFPROBE_PATH=ffprobe
# Provider API keys (optional — never commit real values)
# ATLAS_AUDIO_NOISE_REDUCTION_API_KEY=
# ATLAS_AUDIO_STEM_API_KEY=
# ATLAS_AUDIO_TUNING_API_KEY=
# ATLAS_AUDIO_GENERATION_API_KEY=
# ATLAS_AUDIO_MASTERING_API_KEY=
# ATLAS_AUDIO_MIXING_API_KEY=

# ── Voice / TTS (server-side only; never expose provider secrets to client) ──
# Provider: elevenlabs | openai | mock
# ATLAS_TTS_PROVIDER=mock
# ATLAS_TTS_DRY_RUN=true
# ATLAS_TTS_DEFAULT_VOICE=lara
# ATLAS_TTS_DEFAULT_LANGUAGE=tr-TR
# ATLAS_TTS_DEFAULT_FORMAT=mp3
# ATLAS_TTS_MAX_TEXT_LENGTH=2500
# ATLAS_TTS_TIMEOUT_MS=30000
# ATLAS_TTS_CACHE_ENABLED=true
# ATLAS_TTS_ANON_RATE_MAX=5
# ATLAS_TTS_AUTH_RATE_MAX=30
# ATLAS_TTS_DAILY_CHAR_QUOTA=50000
# ATLAS_TTS_DAILY_REQUEST_QUOTA=200
# ELEVENLABS_API_KEY=
# ELEVENLABS_LARA_VOICE_ID=
# ELEVENLABS_LARA_VOICE_ID_TR=
# ELEVENLABS_LARA_VOICE_ID_EN=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=

# ── Premium / entitlements ──
# PREMIUM_MONTHLY_PRICE_TRY=
# PREMIUM_CURRENCY=TRY
# PREMIUM_PRODUCT_ID=atlas_premium_monthly
# PREMIUM_PRODUCT_NAME=Lara Prime
# Optional server-only Premium allowlist (comma-separated userIds):
# ATLAS_PREMIUM_USER_IDS=web:abc123

# ── Billing (Iyzico first; provider-independent architecture) ──
# ATLAS_BILLING_PROVIDER=iyzico
# ATLAS_BILLING_DRY_RUN=true
# ATLAS_BILLING_LIVE_CHECKOUT=false
# ATLAS_BILLING_WEBHOOK_SECRET=
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# IYZICO_CALLBACK_URL=http://localhost:3001/api/billing/callback/iyzico
# BILLING_RESULT_ORIGIN=http://localhost:5173
#
# Merchant payout / accounting (server-only — never commit real IBAN)
# PREMIUM_PAYOUT_IBAN=
# PREMIUM_PAYOUT_ACCOUNT_NAME=
# PREMIUM_PAYOUT_BANK_NAME=
# PREMIUM_PAYOUT_CURRENCY=TRY

# ── Production hosting ──
# NODE_ENV=production
# ATLAS_SERVE_FRONTEND=1
# ATLAS_SECURE_COOKIES=true
# ATLAS_CORS_ORIGINS=https://cosmicsimya.com,https://www.cosmicsimya.com
# FRONTEND_ORIGIN=https://cosmicsimya.com
# Leave VITE_BACKEND_URL unset for same-origin /api (recommended).
# Set VITE_BACKEND_URL only when the SPA is on a different host than the API.

# Telegram: numeric from.id only (comma-separated for multiple)
# ATLAS_FOUNDER_TELEGRAM_IDS=123456789
# Web: localStorage key atlas_web_session_id (web: prefix optional)
# ATLAS_FOUNDER_WEB_USER_IDS=1730123456789-abc123xyz
# Combined full userIds (optional alternative)
# ATLAS_FOUNDER_USER_IDS=telegram:123456789,web:1730123456789-abc123xyz

# Founder account provisioning (CLI: npm run provision:founder) — never commit real values
# ATLAS_FOUNDER_USERNAME=
# ATLAS_FOUNDER_PASSWORD=
# ATLAS_FOUNDER_EMAIL=

# ── Google OAuth (cPanel Node.js → Environment Variables) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
#
# cPanel'e eklenecek zorunlu anahtarlar (isimler birebir):
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
# Önerilen:
#   GOOGLE_REDIRECT_URI=https://cosmicsimya.com/api/auth/oauth/callback
#   FRONTEND_ORIGIN=https://cosmicsimya.com
#   ATLAS_SECURE_COOKIES=true
#   NODE_ENV=production
#
# Authorized JavaScript origins:
#   https://cosmicsimya.com
#   https://www.cosmicsimya.com
# Authorized redirect URIs (exact match, no trailing slash) — prefer oauth path on LiteSpeed:
#   https://cosmicsimya.com/api/auth/oauth/callback
#   https://cosmicsimya.com/api/auth/google/callback   (legacy)
# Yerel API (isteğe bağlı):
#   http://localhost:3001/api/auth/oauth/callback
#
# GOOGLE_REDIRECT_URI boş bırakılırsa FRONTEND_ORIGIN + /api/auth/oauth/callback
# (production'da varsayılan: https://cosmicsimya.com/api/auth/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cosmicsimya.com/api/auth/oauth/callback
# Optional aliases: ATLAS_GOOGLE_CLIENT_ID, ATLAS_GOOGLE_CLIENT_SECRET, ATLAS_GOOGLE_REDIRECT_URI
# Optional HMAC key for OAuth state cookie (defaults to derived from client secret):
# ATLAS_OAUTH_STATE_SECRET=
